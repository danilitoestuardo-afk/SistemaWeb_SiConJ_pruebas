# URL de la API (sin /api al final). Local: dotnet run usa http://localhost:5000
# Producción: la URL pública que te da Railway, por ejemplo https://siconj-api.up.railway.app
VITE_API_URL=http://localhost:5000

# Número de WhatsApp de la tienda con código de país y sin signos (opcional). Ej: 50255551234
VITE_WHATSAPP=

# Clave de Google Maps (Maps JavaScript API) para que el cliente marque dónde recibir su pedido (opcional).
# Sin clave todo funciona igual: el cliente escribe la dirección o usa su ubicación actual.
VITE_GOOGLE_MAPS_KEY=

# Opcional: ID de mapa de Google. Si lo dejas vacío se usa uno de pruebas (DEMO_MAP_ID).
VITE_GOOGLE_MAP_ID=
